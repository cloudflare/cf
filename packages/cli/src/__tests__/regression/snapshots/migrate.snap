    ],
    "exitCode": 1,
    "error": "Unsupported Wrangler config format for <workspace>/project. Expected .json, .jsonc, or .toml.",
    "requests": []
  },
  {
    "case": "local",
    "argv": [
      "migrate",
      "project",
      "--force",
