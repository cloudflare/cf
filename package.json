{
	"name": "@cloudflare/cf-root",
	"private": true,
	"type": "module",
	"scripts": {
		"generate": "pnpm --filter cf generate",
		"build": "pnpm generate && pnpm --filter cf build",
		"dev": "pnpm --filter cf dev",
		"check": "pnpm generate && vp check && pnpm --filter cf check:type",
		"check:lint": "vp lint --deny-warnings --type-aware",
		"check:format": "vp fmt --check",
		"check:type": "pnpm generate && pnpm --filter cf check:type",
		"fix": "vp lint --fix --type-aware && vp fmt",
		"sync:forge": "tsx scripts/sync-forge.ts",
		"changeset": "changeset",
		"changeset:version": "changeset version && vp fmt packages/cli/CHANGELOG.md"
	},
	"devDependencies": {
		"@changesets/cli": "2.31.0",
		"@types/node": "25.3.5",
		"@typescript/native-preview": "latest",
		"tsx": "4.21.0",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"packageManager": "pnpm@12.6.0"
}
