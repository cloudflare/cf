[
  {
    "case": "no-args",
    "argv": [
      "access",
      "token"
    ],
    "exitCode": 1,
    "error": "Not enough non-option arguments: got 0, need at least 1",
    "requests": []
  },
  {
    "case": "required",
    "argv": [
      "access",
      "token",
      "https://example.com/a?x=1&y=two"
    ],
    "exitCode": 0,
    "requests": []
  },
  {
    "case": "global quiet",
    "argv": [
      "access",
      "token",
      "https://example.com/a?x=1&y=two",
      "--quiet"
    ],
    "exitCode": 0,
    "requests": []
  },
  {
    "case": "global zone",
    "argv": [
      "access",
      "token",
      "https://example.com/a?x=1&y=two",
      "--zone",
      "abcdef0123456789abcdef0123456789"
    ],
    "exitCode": 0,
    "requests": []
  },
  {
    "case": "global profile and mode",
    "argv": [
      "access",
      "token",
      "https://example.com/a?x=1&y=two",
      "--profile",
      "default",
      "--mode",
      "regression"
    ],
    "exitCode": 0,
    "requests": []
  },
  {
    "case": "local",
    "argv": [
      "access",
      "token",
      "https://example.com/a?x=1&y=two",
      "--local"
    ],
    "exitCode": 1,
    "error": "--local is not supported by cf access token.",
    "requests": []
  },
  {
    "case": "local with persistence",
    "argv": [
      "access",
      "token",
      "https://example.com/a?x=1&y=two",
      "--local",
      "--persist-to",
      "regression-state"
    ],
    "exitCode": 1,
    "error": "--local is not supported by cf access token.",
    "requests": []
  },
  {
    "case": "dry-run",
    "argv": [
      "access",
      "token",
      "https://example.com/a?x=1&y=two",
      "--dry-run"
    ],
    "exitCode": 0,
    "requests": []
  }
]
