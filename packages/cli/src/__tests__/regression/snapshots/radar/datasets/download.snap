[
  {
    "case": "no-args",
    "argv": [
      "radar",
      "datasets",
      "download"
    ],
    "exitCode": 1,
    "error": "--dataset-id is required (or pass --body with this field set).",
    "requests": []
  },
  {
    "case": "required",
    "argv": [
      "radar",
      "datasets",
      "download",
      "--dataset-id",
      "1",
      "--body",
      "{\"regression\":\"body &/?+ü\",\"items\":[1,2]}"
    ],
    "exitCode": 0,
    "requests": [
      {
        "method": "POST",
        "url": "https://api.test/client/v4/radar/datasets/download",
        "headers": {
          "accept": "*/*",
          "accept-encoding": "br, gzip, deflate",
          "accept-language": "*",
          "authorization": "Bearer regression-api-token",
          "connection": "keep-alive",
          "content-length": "42",
          "content-type": "application/json",
          "host": "api.test",
          "sec-fetch-mode": "cors",
          "user-agent": "cf-cli/<version>",
          "x-cf-cli-agent": "codex",
          "x-cf-cli-mode": "ci"
        },
        "body": {
          "regression": "body &/?+ü",
          "items": [
            1,
            2
          ]
        }
      }
    ]
  },
