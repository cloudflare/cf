[
  {
    "case": "no-args",
    "argv": [
      "containers",
      "images",
      "list"
    ],
    "exitCode": 0,
    "requests": [
      {
        "method": "POST",
        "url": "https://api.test/client/v4/accounts/0123456789abcdef0123456789abcdef/containers/registries/registry.cloudflare.com/credentials",
        "headers": {
          "accept": "application/json",
          "accept-encoding": "br, gzip, deflate",
          "accept-language": "*",
          "authorization": "Bearer regression-api-token",
          "connection": "keep-alive",
          "content-length": "47",
          "content-type": "application/json",
          "host": "api.test",
          "sec-fetch-mode": "cors",
          "user-agent": "cf-cli/<version>",
          "x-cf-cli-agent": "codex",
          "x-cf-cli-mode": "ci"
        },
        "body": {
          "expiration_minutes": 5,
          "permissions": [
            "pull"
          ]
        }
      },
      {
        "method": "GET",
        "url": "https://registry.cloudflare.com/v2/_catalog?tags=true",
        "headers": {
          "accept": "*/*",
          "accept-encoding": "br, gzip, deflate",
          "accept-language": "*",
          "authorization": "Basic djE6cmVncmVzc2lvbi1wYXNzd29yZA==",
          "connection": "keep-alive",
          "host": "registry.cloudflare.com",
          "sec-fetch-mode": "cors",
          "user-agent": "node"
        },
        "body": null
      }
    ]
  },
  {
