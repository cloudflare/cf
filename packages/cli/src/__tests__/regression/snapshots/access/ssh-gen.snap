[
  {
    "case": "no-args",
    "argv": [
      "access",
      "ssh-gen"
    ],
    "exitCode": 1,
    "error": "Missing required argument: hostname",
    "requests": []
  },
  {
    "case": "required",
    "argv": [
      "access",
      "ssh-gen",
      "--hostname",
      "example.com"
    ],
    "exitCode": 0,
    "requests": []
  },
  {
    "case": "global quiet",
    "argv": [
      "access",
      "ssh-gen",
      "--hostname",
      "example.com",
      "--quiet"
    ],
    "exitCode": 0,
    "requests": []
  },
  {
    "case": "global zone",
    "argv": [
      "access",
      "ssh-gen",
      "--hostname",
      "example.com",
      "--zone",
      "abcdef0123456789abcdef0123456789"
    ],
    "exitCode": 0,
    "requests": []
  },
  {
    "case": "global profile and mode",
    "argv": [
      "access",
      "ssh-gen",
      "--hostname",
      "example.com",
      "--profile",
      "default",
      "--mode",
      "regression"
    ],
    "exitCode": 0,
    "requests": []
  },
  {
    "case": "local",
    "argv": [
      "access",
      "ssh-gen",
      "--hostname",
      "example.com",
      "--local"
    ],
    "exitCode": 1,
    "error": "--local is not supported by cf access ssh-gen.",
    "requests": []
  },
  {
    "case": "local with persistence",
    "argv": [
      "access",
      "ssh-gen",
      "--hostname",
      "example.com",
      "--local",
      "--persist-to",
      "regression-state"
    ],
    "exitCode": 1,
    "error": "--local is not supported by cf access ssh-gen.",
    "requests": []
  },
  {
    "case": "dry-run",
    "argv": [
      "access",
      "ssh-gen",
      "--hostname",
      "example.com",
      "--dry-run"
    ],
    "exitCode": 0,
    "requests": []
  }
]
