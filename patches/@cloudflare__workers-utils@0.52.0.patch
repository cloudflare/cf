+function getCustomApiHeaders() {
+  const raw = process.env.CLOUDFLARE_API_HEADERS;
+  if (!raw) {
+    return {};
+  }
+  let parsed;
+  try {
+    parsed = JSON.parse(raw);
+  } catch {
+    throw configurationError("must be a JSON object with string values.");
+  }
+  if (parsed === null || typeof parsed !== "object" || Array.isArray(parsed)) {
+    throw configurationError("must be a JSON object with string values.");
+  }
+  const headers = {};
+  for (const [name, value] of Object.entries(parsed)) {
+    if (typeof value !== "string") {
+      throw configurationError("must contain only string values.");
+    }
+    try {
+      validateHeaderName(name);
+      validateHeaderValue(name, value);
+    } catch {
+      throw configurationError(
+        "contains an invalid HTTP header name or value."
+      );
+    }
+    const key = name.toLowerCase();
+    if (protectedHeaders.has(key)) {
+      throw configurationError(`cannot set the protected header "${name}".`);
+    }
+    if (Object.hasOwn(headers, key)) {
+      throw configurationError(`contains duplicate header "${name}".`);
+    }
+    Object.defineProperty(headers, key, {
+      value,
+      enumerable: true,
+      configurable: true,
+      writable: true
+    });
+  }
+  return headers;
+}
+function addCustomApiHeaders(headers) {
+  for (const [name, value] of Object.entries(getCustomApiHeaders())) {
+    headers.set(name, value);
+  }
+}
+function redactCustomApiHeaders(headers) {
+  const custom = getCustomApiHeaders();
+  const sanitize = getSanitizeLogs();
+  return Object.fromEntries(
+    Array.from(headers, ([name, value]) => [
+      name,
+      sanitize && Object.hasOwn(custom, name.toLowerCase()) ? "[REDACTED]" : value
+    ])
+  );
+}
+export {
+  addCustomApiHeaders,
+  getCustomApiHeaders,
+  redactCustomApiHeaders
+};
