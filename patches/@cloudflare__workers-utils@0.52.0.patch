+/** Read additional API headers without retaining environment values between calls. */
+declare function getCustomApiHeaders(): Record<string, string>;
+/** Apply configured headers, overriding existing unprotected API request headers. */
+declare function addCustomApiHeaders(headers: {
+    set(name: string, value: string): void;
+}): void;
+/** Format custom headers using the existing debug-log sanitization setting. */
+declare function redactCustomApiHeaders(headers: Iterable<readonly [string, string]>): Record<string, string>;
+
+export { addCustomApiHeaders, getCustomApiHeaders, redactCustomApiHeaders };
