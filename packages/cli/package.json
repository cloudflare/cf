{
	"name": "cf",
	"version": "1.0.0-beta.28",
	"description": "The Cloudflare CLI",
	"keywords": [
		"ai",
		"api",
		"cdn",
		"cf",
		"cli",
		"cloudflare",
		"d1",
		"dns",
		"images",
		"kv",
		"pages",
		"queues",
		"r2",
		"stream",
		"waf",
		"workers",
		"zero-trust"
	],
	"homepage": "https://github.com/cloudflare/cf#readme",
	"bugs": {
		"url": "https://github.com/cloudflare/cf/issues"
	},
	"license": "MIT OR Apache-2.0",
	"author": "Cloudflare, Inc.",
	"repository": {
		"type": "git",
		"url": "https://github.com/cloudflare/cf.git",
		"directory": "packages/cli"
	},
	"bin": {
		"cf": "./bin/cf",
		"cloudflare": "./bin/cf"
	},
	"files": [
		"bin",
		"dist",
		"LICENSE-APACHE",
		"LICENSE-MIT"
	],
	"type": "module",
	"main": "./dist/index.mjs",
	"imports": {
		"#commands/*": "./src/commands/*",
		"#lib/*": "./src/lib/*",
		"#api": "./src/api/index.ts",
		"#operations/*": "./src/commands/_generated/_operations/*"
	},
	"exports": {
		".": "./dist/index.mjs",
		"./config": {
			"types": "./dist/config.d.mts",
			"import": "./dist/config.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"generate": "vp run task:generate",
		"dev": "vp run task:dev",
		"build": "vp run task:build",
		"build:test": "vp run task:build:test",
		"check:type": "vp run task:check:type",
		"test": "vp run task:test",
		"test:watch": "vp run task:test:watch",
		"test:imports": "vp run task:test:imports"
	},
	"dependencies": {
		"@cloudflare/build-output-utils": "https://pkg.pr.new/@cloudflare/build-output-utils@55b5567f278ce000cd4a6e00bfeeef06df596cde",
		"@cloudflare/config": "https://pkg.pr.new/@cloudflare/config@55b5567f278ce000cd4a6e00bfeeef06df596cde",
		"@cloudflare/runtime-types": "0.1.23",
		"blake3-wasm": "2.1.5",
		"miniflare": "https://pkg.pr.new/miniflare@55b5567f278ce000cd4a6e00bfeeef06df596cde"
	},
	"devDependencies": {
		"@bomb.sh/tab": "0.0.22",
		"@bytecodealliance/jco": "1.40.0",
		"@clack/core": "1.5.1",
		"@clack/prompts": "^1.8.1",
		"@cloudflare/autoconfig": "0.9.3",
		"@cloudflare/cli-shared-helpers": "0.3.4",
		"@cloudflare/codemods": "https://pkg.pr.new/@cloudflare/codemods@55b5567f278ce000cd4a6e00bfeeef06df596cde",
		"@cloudflare/containers-shared": "https://pkg.pr.new/@cloudflare/containers-shared@55b5567f278ce000cd4a6e00bfeeef06df596cde",
		"@cloudflare/deploy-helpers": "https://pkg.pr.new/@cloudflare/deploy-helpers@55b5567f278ce000cd4a6e00bfeeef06df596cde",
		"@cloudflare/forge": "https://pkg.pr.new/cloudflare/forge/@cloudflare/forge@0d1877431691b07cbe3b042a4b64cb0bd8e81c03",
		"@cloudflare/workers-auth": "0.16.0",
		"@cloudflare/workers-utils": "https://pkg.pr.new/@cloudflare/workers-utils@55b5567f278ce000cd4a6e00bfeeef06df596cde",
		"@types/node": "26.6.6",
		"@types/semver": "7.8.0",
		"@types/shell-quote": "^1.7.5",
		"@types/yargs": "17.0.35",
		"chalk": "6.0.1",
		"ci-info": "^4.4.0",
		"esbuild": "0.28.2",
		"figures": "6.1.0",
		"minimatch": "11.0.3",
		"minisearch": "7.2.0",
		"msw": "3.0.3",
		"semver": "7.8.5",
		"shell-quote": "^1.12.0",
		"tinyexec": "^1.3.1",
		"tsx": "4.21.0",
		"undici": "8.12.3",
		"vite-plus": "catalog:",
		"yargs": "18.2.0"
	},
	"engines": {
		"node": "^22.23.0 || ^24.22.0 || ^26.12.0"
	}
}
