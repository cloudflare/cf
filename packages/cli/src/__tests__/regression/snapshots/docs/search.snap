[
  {
    "case": "no-args",
    "argv": [
      "docs",
      "search"
    ],
    "exitCode": 1,
    "error": "Not enough non-option arguments: got 0, need at least 1",
    "requests": []
  },
  {
    "case": "required",
    "argv": [
      "docs",
      "search",
      "regression value &/?+ü"
    ],
    "exitCode": 0,
    "requests": [
      {
        "method": "POST",
        "url": "https://ai-search.developers.cloudflare.com/api/ai-search/search",
        "headers": {
          "accept": "application/json",
          "accept-encoding": "br, gzip, deflate",
          "accept-language": "*",
          "connection": "keep-alive",
          "content-length": "158",
          "content-type": "application/json",
          "host": "ai-search.developers.cloudflare.com",
          "sec-fetch-mode": "cors",
          "user-agent": "cf-cli/<version>",
          "x-cf-cli-agent": "codex",
          "x-cf-cli-mode": "ci"
        },
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "regression value &/?+ü"
            }
          ],
          "stream": false,
          "ai_search_options": {
            "retrieval": {
              "metadata_only": true,
              "max_num_results": 5
            }
          }
        }
      }
    ]
  },
