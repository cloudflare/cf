{
	$schema: "https://docs.renovatebot.com/renovate-schema.json",
	extends: ["config:recommended", "group:allNonMajor"],
	enabledManagers: ["npm", "github-actions"],
	ignoreDeps: [
		// This dependency is patched locally, so updates require a manual patch review.
		"@changesets/cli",
		// Keep this pinned to the known-compatible version.
		"blake3-wasm",
		// Keep the supported Node range broad instead of raising its minimum version.
		"node",
		// tsx 4.23.1+ exhausts file handles during SDK generation on macOS and Windows.
		"tsx",
	],
	dependencyDashboard: false,
	labels: ["dependencies"],
	minimumReleaseAge: "3 days",
	// One workers-sdk release can update several groups at once. The default
	// limit of two PRs per hour silently skips the rest until the next run.
	prHourlyLimit: 0,
	rangeStrategy: "bump",
	postUpdateOptions: ["pnpmDedupe"],
	schedule: ["on monday"],
	packageRules: [
		{
			description: "Update GitHub Actions separately from package dependencies",
			matchManagers: ["github-actions"],
			pinDigests: true,
			groupName: "GitHub Actions",
			groupSlug: "github-actions",
		},
		{
			description: "Update packages published from workers-sdk together",
			matchPackageNames: [
				"@cloudflare/autoconfig",
				"@cloudflare/build-output-utils",
				"@cloudflare/cli-shared-helpers",
				"@cloudflare/codemods",
				"@cloudflare/config",
				"@cloudflare/containers-shared",
				"@cloudflare/deploy-helpers",
				"@cloudflare/runtime-types",
				"@cloudflare/workers-auth",
				"@cloudflare/workers-utils",
				"miniflare",
			],
			enabled: true,
			groupName: "workers-sdk derived dependencies",
			groupSlug: "workers-sdk",
			minimumReleaseAge: "0 minutes",
			postUpgradeTasks: {
				commands: ["node ./scripts/create-workers-sdk-changeset.mjs"],
				dataFileTemplate: "{{{toJSON upgrades}}}",
				executionMode: "branch",
				fileFilters: [".changeset/renovate-workers-sdk-*.md"],
			},
			schedule: ["at any time"],
		},
		{
			description: "Update workers-sdk dependencies used only by tests and fixtures together",
			matchPackageNames: [
				"@cloudflare/vite-plugin",
				"@cloudflare/workers-types",
				"wrangler",
			],
			groupName: "workers-sdk derived test and fixture dependencies",
			groupSlug: "workers-sdk-test-fixtures",
			minimumReleaseAge: "0 minutes",
			schedule: ["at any time"],
		},
		{
			description: "Follow Miniflare's beta release",
			matchPackageNames: ["miniflare"],
			followTag: "beta",
		},
		{
			description: "Follow the Vite plugin's release candidate",
			matchPackageNames: ["@cloudflare/vite-plugin"],
			followTag: "rc",
		},
		{
			description: "Update pnpm",
			matchPackageNames: ["pnpm"],
			groupName: "pnpm",
			groupSlug: "pnpm",
		},
		{
			description: "Do not update the bundled Vite and Vitest pins independently of Vite+",
			matchManagers: ["npm"],
			matchPackageNames: ["@voidzero-dev/vite-plus-core", "vitest"],
			matchFileNames: ["pnpm-workspace.yaml"],
			enabled: false,
		},
		{
			description: "Sync the workspace Vite and Vitest pins before refreshing the lockfile",
			matchManagers: ["npm"],
			matchPackageNames: ["vite-plus"],
			matchFileNames: ["pnpm-workspace.yaml"],
			groupName: "Vite+ toolchain",
			groupSlug: "vite-plus",
			constraints: { node: "22" },
			skipArtifactsUpdate: true,
			postUpgradeTasks: {
				installTools: { node: {}, pnpm: {} },
				commands: ["node ./scripts/sync-vite-plus.mjs"],
				executionMode: "update",
				fileFilters: ["pnpm-workspace.yaml", "pnpm-lock.yaml"],
			},
		},
		{
			description: "Update the Forge build, then regenerate the commands from the pinned OpenAPI release (scripts/update-openapi.ts moves that pin)",
			matchPackageNames: ["@cloudflare/forge"],
			groupName: "Forge",
			groupSlug: "forge",
			minimumReleaseAge: "0 minutes",
			schedule: ["at any time"],
			// Post-upgrade tasks run in Renovate's slim image, which installs tools on demand.
			constraints: { node: "22" },
			postUpgradeTasks: {
				installTools: { node: {}, pnpm: {} },
				// The npm manager edits only package.json, so pnpm refreshes the lockfile here.
				commands: [
					"pnpm install --no-frozen-lockfile",
					"pnpm generate",
					"node ./scripts/create-forge-changeset.mjs",
				],
				dataFileTemplate: "{{{toJSON upgrades}}}",
				executionMode: "branch",
				fileFilters: [
					"pnpm-lock.yaml",
					"packages/cli/src/commands/_generated/**",
					".changeset/renovate-forge-*.md",
				],
			},
		},
	],
}
