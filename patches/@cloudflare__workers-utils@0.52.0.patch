+  "content-type",
+  "content-encoding",
+  "content-length",
+  "connection",
+  "transfer-encoding",
+  "upgrade",
+  "te",
+  "trailer"
+]);
+function configurationError(message) {
+  return new UserError(`CLOUDFLARE_API_HEADERS ${message}`, {
+    telemetryMessage: "cfetch custom api headers invalid configuration"
+  });
