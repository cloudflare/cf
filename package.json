{
	"name": "@cloudflare/cf-root",
	"private": true,
	"type": "module",
	"scripts": {
		"generate": "vp run cf#task:generate",
		"build": "vp run -r task:build",
		"dev": "vp run cf#task:dev",
		"check": "vp run repo:check",
		"check:lint": "vp run repo:lint",
		"check:format": "vp run repo:format",
		"check:type": "vp run -r task:check:type",
		"fix": "vp lint --fix --type-aware && vp fmt",
		"sync:forge": "tsx scripts/sync-forge.ts",
		"changeset": "changeset",
		"changeset:version": "changeset version && vp fmt packages/cli/CHANGELOG.md"
	},
	"devDependencies": {
		"@changesets/cli": "2.31.0",
		"@types/node": "25.9.9",
		"@typescript/native-preview": "latest",
		"tinyexec": "1.3.1",
		"tsx": "4.21.0",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": "^22.18.0 || ^24.11.0 || >=26.0.0"
	},
	"packageManager": "pnpm@12.6.0"
}
