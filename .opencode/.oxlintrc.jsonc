{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "import", "unicorn"],
	"categories": {
		"correctness": "error",
	},
	"rules": {
		// Stricter than default (default = warn)
		"@typescript-eslint/no-explicit-any": "error",
		"@typescript-eslint/no-non-null-assertion": "error",
		"@typescript-eslint/consistent-type-imports": "error",
		// Default = off, opting in
		"no-shadow": ["error", { "allow": ["expect"] }],
		// Default = warn, upgrade to error + replace biome's noUnusedImports
		"no-unused-vars": [
			"error",
			{
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_",
				"ignoreRestSiblings": true,
				"fix": { "imports": "fix" },
			},
		],
		// Stylistic — default off
		"curly": ["error", "all"],
		// turbo plugin
		"turbo/no-undeclared-env-vars": "error",
	},
	"ignorePatterns": [
		// Pre-existing tech debt; scheduled for rewrites in @cloudflare/forge itself.
		// Matches the tsconfig exclusion for the same reason.
		"packages/cli/generator/**",
		// Generated by `pnpm generate` — checked in but not hand-edited,
		// so linting it is noise (and slows the run).
		"packages/cli/src/commands/_generated/**",
		"packages/cli/src/sdk/sdk/**",
		"packages/cli/src/lib/completions/**",
	],
	"jsPlugins": ["eslint-plugin-turbo"],
}
